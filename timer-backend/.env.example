# Server Configuration
PORT=10000
HOST=0.0.0.0
NODE_ENV=development

# Master Admin Key (for pairing bootstrap)
ADMIN_SECRET=change-this-to-a-secure-random-passphrase

# LiveKit Credentials (from your LiveKit Cloud / self-hosted dashboard)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Optional: Firebase Cloud Messaging Server Key (for background wake-up push)
FCM_SERVER_KEY=
